    "m_SourceType": 1,
    "m_FunctionName": "Shadow_InLined",
    "m_FunctionSource": "",
    "m_FunctionBody": "#if SHADOWS_SCREEN\n    float4 shadowCoord = ComputeScreenPos(UnityWorldToClipPos(WorldPos));\n    Shadow = tex2D(_ShadowMapTexture, shadowCoord.xy / shadowCoord.w).r;\n#else\n    Shadow = 1.0;\n#endif"
}

